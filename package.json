{
  "name": "pixelstage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pixelstage": "./cli/pixelstage.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.ts",
    "catalog": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/generate-vanilla-catalog.ts",
    "build:cf": "NEXT_PUBLIC_BASE_PATH=/mcrender opennextjs-cloudflare build",
    "preview:cf": "NEXT_PUBLIC_BASE_PATH=/mcrender opennextjs-cloudflare build && NEXT_PUBLIC_BASE_PATH=/mcrender opennextjs-cloudflare preview",
    "deploy:cf": "NEXT_PUBLIC_BASE_PATH=/mcrender opennextjs-cloudflare build && NEXT_PUBLIC_BASE_PATH=/mcrender opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "gltf-validator": "^2.0.0-dev.3.10",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
}
