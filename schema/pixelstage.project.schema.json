{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tools.xm1221.cn/mcrender/schema/pixelstage.project.schema.json",
  "title": "Pixelstage project",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "scene", "customs"],
  "properties": {
    "v": { "const": 1 },
    "scene": { "$ref": "#/$defs/scene" },
    "customs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/custom" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "scene": {
      "type": "object",
      "required": ["v", "players"],
      "properties": {
        "v": { "const": 1 },
        "activeId": { "type": "string" },
        "players": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "props": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/prop" }
        },
        "activePropId": { "type": ["string", "null"] },
        "propClip": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/propClip" }] }
      }
    },
    "prop": {
      "type": "object",
      "required": ["id", "catalogId", "position"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,24}$" },
        "catalogId": { "type": "string" },
        "name": { "type": "string", "maxLength": 48 },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/vec3" },
        "rotationY": { "type": "number" },
        "scale": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/vec3" }] },
        "pivot": { "$ref": "#/$defs/vec3" },
        "hidden": { "type": "boolean" },
        "locked": { "type": "boolean" }
      }
    },
    "propClip": {
      "type": "object",
      "required": ["v", "duration", "keyframes"],
      "properties": {
        "v": { "const": 1 },
        "duration": { "type": "number", "minimum": 0.2, "maximum": 30 },
        "loop": { "type": "boolean" },
        "autoKey": { "type": "boolean" },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["time", "values"],
            "properties": {
              "time": { "type": "number", "minimum": 0 },
              "values": { "type": "object" }
            }
          }
        }
      }
    },
    "custom": {
      "type": "object",
      "required": ["id", "name", "kind", "model", "textures"],
      "properties": {
        "id": { "type": "string", "pattern": "^custom:[a-z0-9_]{1,40}$" },
        "name": { "type": "string" },
        "kind": { "enum": ["block", "item"] },
        "model": { "type": "object" },
        "textures": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^data:image/png;base64," }
        }
      }
    }
  }
}
